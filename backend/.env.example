# Copy to backend/.env — the hostnames below are docker-compose service names.
# docker-compose also passes these directly, so you normally only need to fill
# in GROQ_API_KEY.

DATABASE_URL=postgresql://prismadmin:prismpassword@postgres_db:5432/prismdb
MINIO_ENDPOINT_URL=http://minio:9000
MINIO_ACCESS_KEY=prismadmin
MINIO_SECRET_KEY=prismpassword
REDIS_URL=redis://redis:6379/0

# Browser origins allowed to call this API (comma-separated).
FRONTEND_ORIGINS=http://localhost:3000

# Free key from https://console.groq.com — powers prompt-driven pipelines.
# Keep this line even if you leave the placeholder: the Groq client is built at
# import time and raises if the variable is missing entirely.
GROQ_API_KEY=REPLACE_YOUR_GROQ_API_KEY
