# Copy to frontend/.env.local.
# Both Clerk keys are required — the app will not start without them.
# Create a free application at https://clerk.com and take them from API Keys.

NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_REPLACE_ME
CLERK_SECRET_KEY=sk_test_REPLACE_ME
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up

# Backend API base URL. Leave unset for local docker-compose; set it when the
# frontend is deployed somewhere the API is not on localhost.
# NEXT_PUBLIC_API_URL=http://localhost:8000

# Optional — only the contact page's email form uses this.
NEXT_PUBLIC_WEB3FORMS_KEY=
